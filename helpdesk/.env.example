# Modelo público sem credenciais. Crie env/ e copie este arquivo para env/.env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3333
# Preencha somente quando criar o PostgreSQL. Nunca coloque credenciais no Git.
DATABASE_URL=
# true: TLS com certificado verificado (hospedagem). false: apenas banco local.
DATABASE_SSL=true
# Opcional: caminho do certificado CA exigido pelo provedor.
DATABASE_CA_FILE=
# Segredo obrigatório quando DATABASE_URL estiver preenchida.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Use 1 somente atrás de um proxy confiável (por exemplo, o proxy do provedor).
TRUST_PROXY=0
